# Umbraco MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Node.js: Allow self-signed certificates (local Umbraco instances use HTTPS)
# ============================================================================
NODE_TLS_REJECT_UNAUTHORIZED=0

# ============================================================================
# Required: Umbraco Connection Settings
# ============================================================================

# OAuth Client ID for API access
UMBRACO_CLIENT_ID=your-client-id

# OAuth Client Secret
UMBRACO_CLIENT_SECRET=your-client-secret

# Base URL of your Umbraco instance
UMBRACO_BASE_URL=https://localhost:44320

# ============================================================================
# Optional: Tool Filtering
# ============================================================================

# Enable specific tool modes (comma-separated)
# Available modes depend on your mode-registry.ts configuration
# UMBRACO_TOOL_MODES=automate

# Include/exclude specific tool collections (comma-separated)
# UMBRACO_INCLUDE_TOOL_COLLECTIONS=automations,catalogue
# UMBRACO_EXCLUDE_TOOL_COLLECTIONS=version-history

# Include/exclude specific slices (comma-separated)
# UMBRACO_INCLUDE_SLICES=read,list
# UMBRACO_EXCLUDE_SLICES=delete

# Include/exclude specific tools by name (comma-separated)
# UMBRACO_INCLUDE_TOOLS=list-automations,get-automation
# UMBRACO_EXCLUDE_TOOLS=delete-automation

# ============================================================================
# Optional: Security & Restrictions
# ============================================================================

# Run in read-only mode (disables all write operations)
# UMBRACO_READONLY=true

# Restrict media operations to specific paths (comma-separated, resolved to absolute)
# UMBRACO_ALLOWED_MEDIA_PATHS=/media/uploads,/media/images

# ============================================================================
# Optional: Server Options (defined in src/config/server-config.ts)
# ============================================================================

# Turn off chaining to the Umbraco CMS MCP server (cms--* tools)
# DISABLE_MCP_CHAINING=true

# Override the Umbraco major version this server targets (normally leave unset -
# this v17 line targets 17; build from main for Umbraco 18)
# UMBRACO_EXPECTED_MAJOR=17
