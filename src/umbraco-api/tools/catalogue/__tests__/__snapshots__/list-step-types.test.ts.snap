      {
        "alias": "umbracoAutomate.runScript",
        "connectionTypeAlias": null,
        "description": "Runs a JavaScript function against the trigger and previous step outputs and returns its result.",
        "group": "Core",
        "hasDynamicOutcomes": false,
        "hasDynamicOutputSchema": true,
        "icon": "icon-script",
        "name": "Run Script",
        "outcomes": [],
        "outputSchema": {
          "properties": {
            "result": {
              "description": "The value returned by the script's default export, as JSON that downstream steps can bind to.",
            },
          },
          "type": "object",
        },
        "settingsSchema": {
          "fields": [
            {
              "defaultValue": "export default function (data) {
    return data;
}",
              "description": "JavaScript module. Export a default function that takes a single \`data\` argument and returns a result. \`data\` holds the same values bindings can reach, at the same paths: \`data.trigger\`, \`data.steps.<alias>\`, \`data.previous\` and, inside a loop, \`data.loop.item\` / \`data.loop.index\`. Bindings are not resolved inside the script itself. The returned value becomes this step's output (as JSON) for later steps to bind to.

\`\`\`js
export default function (data) {
    const bytes = data.steps.getMedia.properties.umbracoBytes;
    return { sizeKb: Math.round(bytes / 1024) };
}
\`\`\`",
              "editorConfig": "[{ "alias": "language", "value": "javascript" },{ "alias": "height", "value": 300 },{ "alias": "lineNumbers", "value": true },{ "alias": "minimap", "value": false },{ "alias": "wordWrap", "value": true }]",
              "editorUiAlias": "Umb.PropertyEditorUi.CodeEditor",
              "group": null,
              "isRequired": true,
              "isSensitive": false,
              "key": "script",
              "label": "Script",
              "sortOrder": 0,
              "supportsBindings": false,
              "valueKind": "String",
              "visibleWhen": null,
            },
            {
              "defaultValue": null,
              "description": "Optional JSON Schema describing what the script returns. Leave empty to expose the result as a single value. When set, later steps can bind to the individual properties, e.g. \`result.upper\`.

\`\`\`json
{
    "type": "object",
    "properties": { "upper": { "type": "string" } }
}
\`\`\`",
              "editorConfig": "[{ "alias": "language", "value": "json" },{ "alias": "height", "value": 200 },{ "alias": "lineNumbers", "value": true },{ "alias": "minimap", "value": false },{ "alias": "wordWrap", "value": true }]",
              "editorUiAlias": "Umb.PropertyEditorUi.CodeEditor",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "outputSchema",
              "label": "Output schema",
              "sortOrder": 1,
              "supportsBindings": false,
              "valueKind": "String",
              "visibleWhen": null,
            },
            {
              "defaultValue": false,
              "description": "Allow the script to make outbound HTTP requests using fetch(). Off by default. Requests are SSRF-protected and also need fetch enabled site-wide.",
              "editorConfig": null,
              "editorUiAlias": "Umb.PropertyEditorUi.Toggle",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "allowFetch",
              "label": "Allow fetch",
              "sortOrder": 2,
              "supportsBindings": false,
              "valueKind": "Scalar",
              "visibleWhen": null,
            },
          ],
        },
        "type": "action",
      },
