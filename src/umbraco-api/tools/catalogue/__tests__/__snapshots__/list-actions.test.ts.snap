              "valueKind": "Scalar",
              "visibleWhen": null,
            },
            {
              "defaultValue": null,
              "description": "The request body content.",
              "editorConfig": "[
    { "alias": "language", "value": "plaintext" },
    { "alias": "height", "value": 150 },
    { "alias": "wordWrap", "value": true }
]",
              "editorUiAlias": "Umb.PropertyEditorUi.CodeEditor",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "body",
