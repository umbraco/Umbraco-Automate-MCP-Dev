              "editorUiAlias": "Umb.PropertyEditorUi.TextBox",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "culture",
              "label": "Culture",
              "sortOrder": 1,
              "supportsBindings": true,
              "valueKind": "String",
              "visibleWhen": null,
            },
          ],
