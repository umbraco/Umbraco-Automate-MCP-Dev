              "editorUiAlias": "Umb.Automate.MediaKeyPicker",
              "group": null,
              "isRequired": true,
              "isSensitive": false,
              "key": "mediaKey",
              "label": "Media Key",
              "sortOrder": 0,
              "supportsBindings": true,
              "valueKind": "String",
              "visibleWhen": null,
            },
            {
              "defaultValue": null,
              "description": "Culture code (e.g. en-US) for variant media. Leave blank for invariant.",
