              "isSensitive": false,
              "key": "method",
              "label": "Method",
              "sortOrder": 1,
              "supportsBindings": false,
              "valueKind": "String",
              "visibleWhen": null,
            },
            {
              "defaultValue": "Raw",
              "description": "Raw sends the body text as-is (JSON, XML, ...). Form fields builds an application/x-www-form-urlencoded body and sets the Content-Type for you.",
              "editorConfig": "[{ "alias": "items", "value": ["Raw", "Form"] }]",
              "editorUiAlias": "Umb.PropertyEditorUi.Dropdown",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "bodyMode",
              "label": "Body type",
