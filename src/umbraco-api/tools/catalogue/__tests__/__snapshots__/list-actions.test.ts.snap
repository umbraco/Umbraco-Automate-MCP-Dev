        "alias": "umbracoAutomate.runScript",
        "connectionTypeAlias": null,
        "description": "Runs a JavaScript function against the step inputs and returns its result.",
        "group": "Core",
        "hasDynamicOutputSchema": true,
        "icon": "icon-script",
        "name": "Run Script",
        "outputSchema": {
          "properties": {
            "result": true,
          },
          "type": "object",
        },
        "settingsSchema": {
          "fields": [
            {
              "defaultValue": "export default function (data) {
    return data;
}",
              "description": "JavaScript module. Export a default function that receives the step inputs as its single \`data\` argument and returns a result. The returned value becomes this step's output (as JSON) for later steps to bind to.

\`\`\`js
export default function (data) {
    return { upper: data.name.toUpperCase() };
}
\`\`\`",
              "editorConfig": "[{ "alias": "language", "value": "javascript" },{ "alias": "height", "value": 300 },{ "alias": "lineNumbers", "value": true },{ "alias": "minimap", "value": false },{ "alias": "wordWrap", "value": true }]",
              "editorUiAlias": "Umb.PropertyEditorUi.CodeEditor",
              "group": null,
              "isRequired": true,
              "isSensitive": false,
              "key": "script",
              "label": "Script",
              "sortOrder": 0,
              "supportsBindings": false,
            },
            {
              "defaultValue": null,
              "description": "Optional JSON Schema describing what the script returns. Leave empty to expose the result as a single value. When set, later steps can bind to the individual properties, e.g. \`result.upper\`.

\`\`\`json
{
    "type": "object",
    "properties": { "upper": { "type": "string" } }
}
\`\`\`",
              "editorConfig": "[{ "alias": "language", "value": "json" },{ "alias": "height", "value": 200 },{ "alias": "lineNumbers", "value": true },{ "alias": "minimap", "value": false },{ "alias": "wordWrap", "value": true }]",
              "editorUiAlias": "Umb.PropertyEditorUi.CodeEditor",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "outputSchema",
              "label": "Output schema",
              "sortOrder": 1,
              "supportsBindings": false,
            },
            {
              "defaultValue": true,
              "description": "Allow the script to make outbound HTTP requests using fetch(). Requests are SSRF-protected.",
              "editorConfig": null,
              "editorUiAlias": "Umb.PropertyEditorUi.Toggle",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "allowFetch",
              "label": "Allow fetch",
              "sortOrder": 2,
              "supportsBindings": false,
            },
          ],
        },
        "type": "action",
      },
