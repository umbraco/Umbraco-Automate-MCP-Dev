        "name": "HTTP Request",
        "outcomes": [],
        "outputSchema": {
          "properties": {
            "isSuccess": {
              "description": "Whether the response indicates success (2xx status code).",
              "type": "boolean",
            },
            "responseBody": {
              "description": "The response body as a string.",
              "type": [
                "string",
                "null",
              ],
            },
            "statusCode": {
              "description": "The HTTP status code returned by the server.",
              "type": "integer",
            },
          },
          "type": "object",
