              "visibleWhen": {
                "key": "bodyMode",
                "values": [
                  "Raw",
                ],
              },
            },
            {
              "defaultValue": [],
              "description": "The fields sent as an application/x-www-form-urlencoded body.",
              "editorConfig": null,
              "editorUiAlias": "UmbracoAutomate.PropertyEditorUi.KeyValueEditor",
              "group": null,
              "isRequired": false,
              "isSensitive": false,
              "key": "formFields",
              "label": "Form fields",
              "sortOrder": 4,
              "supportsBindings": true,
              "valueKind": "Collection",
              "visibleWhen": {
                "key": "bodyMode",
                "values": [
                  "Form",
                ],
              },
            },
            {
              "defaultValue": "application/json",
              "description": "The Content-Type header value for a raw body.",
              "editorConfig": null,
              "editorUiAlias": "Umb.PropertyEditorUi.TextBox",
              "group": null,
              "isRequired": true,
              "isSensitive": false,
              "key": "contentType",
              "label": "Content Type",
              "sortOrder": 5,
              "supportsBindings": false,
              "valueKind": "String",
              "visibleWhen": {
                "key": "bodyMode",
                "values": [
